# Optional server-only X API bearer token for public profile/post lookup.
# Never prefix this value with NEXT_PUBLIC_.
X_API_BEARER_TOKEN=

# Public application origin (without a trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Blank uses file:./data/worth.db locally. Use a remote libsql:// URL in production,
# or leave this blank when using the Turso integration pair below.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Vercel's Turso integration supplies these instead. Do not set DATABASE_URL
# above when using this pair; an explicit DATABASE_URL takes precedence.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Set a long random secret before enabling authenticated sessions.
AUTH_SECRET=

# Optional email provider. Booking inquiries are saved in the database.
RESEND_API_KEY=
EMAIL_FROM=

# Only enable behind a trusted deployment proxy that overwrites forwarded headers.
TRUST_PROXY=0
