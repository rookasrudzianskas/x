# Optional server-only X API bearer token for public profile/post lookup.
# Never prefix this value with NEXT_PUBLIC_.
X_API_BEARER_TOKEN=

# Public application origin (without a trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Use local SQLite for development, or a libsql:// Turso URL in production.
DATABASE_URL=file:./data/worth.db
DATABASE_AUTH_TOKEN=

# Set a long random secret before enabling authenticated sessions.
AUTH_SECRET=

# Optional email provider. Booking inquiries are saved in the database.
RESEND_API_KEY=
EMAIL_FROM=

# Only enable behind a trusted deployment proxy that overwrites forwarded headers.
TRUST_PROXY=0
